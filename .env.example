# Скопируйте в .env для локального запуска (npm run dev).
# На Vercel задайте ту же переменную в Settings → Environment Variables и сделайте Redeploy.
# Достаточно ОДНОГО ключа. Не используйте префикс VITE_ — иначе ключ попадёт в браузер.

GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# Необязательно:
# AI_PROVIDER=gemini
# AI_MODEL=gemini-2.5-flash
